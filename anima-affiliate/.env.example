# --- Database (Supabase: Project settings > Database > Connection string, "Session pooler") ---
DATABASE_URL=postgres://postgres:password@host:5432/postgres
# --- Security: generate each with  openssl rand -base64 48 ---
SESSION_SECRET=change-me-to-a-long-random-string
PAYMENT_ENCRYPTION_KEY=change-me-32-bytes-base64
# --- Public address of this portal (no trailing slash) ---
APP_URL=https://partners.animajewel.store
STORE_URL=https://animajewel.store
# --- Shopify (Settings > Apps > Develop apps > your app) ---
SHOPIFY_STORE_DOMAIN=a1xesn-p0.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_WEBHOOK_SECRET=xxx
SHOPIFY_API_VERSION=2025-01
# --- Email (Resend). Leave RESEND_API_KEY empty to only log emails. ---
RESEND_API_KEY=
EMAIL_FROM="Anima Jewels <partners@animajewel.store>"
ADMIN_NOTIFY_EMAIL=support@animajewel.store
CRON_SECRET=change-me-random-string
SETUP_TOKEN=change-me-random-string-24-plus-chars
