{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t }} – {{ shop.name }}</title>
  <meta name="robots" content="noindex">
  {%- render 'theme-styles' -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
</head>
<body>
  <main class="simple-page">
    <div>
      <p class="eyebrow">{{ shop.name }}</p>
      <h1>{{ 'gift_cards.issued.title' | t }}</h1>
      <p class="h2" style="margin:24px 0">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="badge badge--soldout">{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
      <p class="text-muted">{{ 'gift_cards.issued.code' | t }}</p>
      <p class="h3" style="letter-spacing:.12em">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}<p>{{ 'gift_cards.issued.balance' | t: value: gift_card.balance | money }}</p>{%- endif -%}
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:inline-block;margin:24px 0"></div>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
      </p>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy" style="margin:0 auto"></a></p>{%- endif -%}
    </div>
  </main>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
