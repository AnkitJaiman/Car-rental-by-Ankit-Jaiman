<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.layout == 'image_right' %} image-with-text--reverse{% endif %}" style="--media-w: {{ section.settings.media_width | divided_by: 100.0 }}fr">
      <div class="image-with-text__media reveal">
        <div class="image-with-text__media-stack">
          <div class="media media--{{ section.settings.image_ratio }}">
            {%- if section.settings.image != blank -%}
              {%- capture pos -%}object-position: {{ section.settings.image_position }}{%- endcapture -%}
              {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '540, 720, 900, 1100, 1400, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', style: pos }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if section.settings.image_secondary != blank -%}
            <div class="image-with-text__media-secondary">
              <div class="media media--portrait">{% render 'image', image: section.settings.image_secondary, sizes: '22vw', widths: '300, 450, 600' %}</div>
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="image-with-text__content reveal{% if section.settings.text_alignment == 'center' %} image-with-text--center-text{% endif %}"{% if section.settings.text_alignment == 'center' %} style="text-align:center;margin:0 auto"{% endif %}>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- when 'heading' -%}<h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- when 'text' -%}<div class="image-with-text__body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'quote' -%}<blockquote class="h3" style="margin:0 0 3.2rem;font-style:italic" {{ block.shopify_attributes }}>“{{ block.settings.quote | escape }}”</blockquote>
            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-image-with-text",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image focus", "default": "center center", "options": [
      { "value": "center top", "label": "Top" }, { "value": "center center", "label": "Center" }, { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }
    ]},
    { "type": "image_picker", "id": "image_secondary", "label": "Overlapping detail image (desktop, optional)" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "tall", "label": "Tall (2:3)" }, { "value": "landscape", "label": "Landscape (3:2)" }
    ]},
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_left", "options": [
      { "value": "image_left", "label": "Image left" }, { "value": "image_right", "label": "Image right" }
    ]},
    { "type": "range", "id": "media_width", "label": "Image width", "min": 80, "max": 160, "step": 10, "unit": "%", "default": 110 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ]},
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Small text", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Anima means soul" },
      { "type": "select", "id": "size", "label": "Size", "default": "h1", "options": [{ "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" }] }
    ]},
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your brand story here.</p>" }] },
    { "type": "quote", "name": "Quote", "settings": [{ "type": "text", "id": "quote", "label": "Quote" }] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Read our story" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Style", "default": "primary", "options": [{ "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }] }
    ]}
  ],
  "presets": [{
    "name": "Image with text",
    "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" }]
  }]
}
{% endschema %}
