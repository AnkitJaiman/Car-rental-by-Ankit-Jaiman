{%- assign tiles = section.blocks | where: 'type', 'tile' -%}
{%- assign tile_count = 0 -%}
{%- for t in tiles -%}{%- if t.settings.image != blank or t.settings.video != blank -%}{%- assign tile_count = tile_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if tile_count > 0 or request.design_mode -%}
<section class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %}">
    <div class="section-header section-header--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="section-header__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
    <ul class="social-grid" role="list" style="list-style:none;padding:0;margin:0;--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }}; --gap: {{ section.settings.gap }}px;">
      {%- for block in tiles -%}
        {%- assign t = block.settings -%}
        {%- if t.image == blank and t.video == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        <li {{ block.shopify_attributes }}>
          {%- capture tile_inner -%}
            <div class="media media--{{ section.settings.ratio }}"{% if t.video != blank %} data-inspo-video{% endif %}>
              {%- if t.video != blank -%}
                {%- assign poster_img = t.image | default: t.video.preview_image -%}
                {%- if poster_img -%}{% render 'image', image: poster_img, sizes: '(min-width: 990px) 17vw, 50vw', widths: '240, 360, 480, 640', alt: t.caption %}{%- endif -%}
                {%- assign source = t.video.sources | where: 'format', 'mp4' | first -%}
                <video muted loop playsinline preload="none" data-src="{{ source.url }}"{% if poster_img %} poster="{{ poster_img | image_url: width: 640 }}"{% endif %} aria-label="{{ t.caption | default: t.username | escape }}"></video>
              {%- elsif t.image != blank -%}
                {% render 'image', image: t.image, sizes: '(min-width: 990px) 17vw, 50vw', widths: '240, 360, 480, 640, 800', alt: t.caption %}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="social-tile__icon">{% render 'icon', name: section.settings.network %}</span>
            {%- if t.username != blank or t.caption != blank -%}
              <span class="social-tile__overlay">
                {%- if t.username != blank -%}<strong>{{ t.username | escape }}</strong>{%- endif -%}
                {%- if t.caption != blank -%}<span>{{ t.caption | escape | truncatewords: 14 }}</span>{%- endif -%}
              </span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if t.link != blank -%}
            <a href="{{ t.link }}" class="social-tile" target="_blank" rel="noopener" aria-label="{{ t.caption | default: t.username | default: section.settings.network | escape }}">{{ tile_inner }}</a>
          {%- else -%}
            <div class="social-tile">{{ tile_inner }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top:40px">
        <a href="{{ section.settings.button_link | default: settings.social_instagram | default: '#' }}" class="button button--secondary" target="_blank" rel="noopener">{% render 'icon', name: section.settings.network %} {{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Social community",
  "tag": "div",
  "class": "section-social",
  "max_blocks": 24,
  "settings": [
    { "type": "paragraph", "content": "Upload images and videos manually — no Instagram app required. An Instagram feed app block can also be added to any page if you install one." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "@animajewels" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our community" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "network", "label": "Icon", "default": "instagram", "options": [
      { "value": "instagram", "label": "Instagram" }, { "value": "tiktok", "label": "TikTok" }, { "value": "pinterest", "label": "Pinterest" }
    ]},
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 2, "max": 3, "step": 1, "default": 2 },
    { "type": "select", "id": "ratio", "label": "Tile ratio", "default": "square", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait (4:5)" }
    ]},
    { "type": "range", "id": "gap", "label": "Spacing", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 6 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the Instagram URL in Theme settings." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "tile", "name": "Post", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "video", "id": "video", "label": "Video (optional)" },
      { "type": "text", "id": "username", "label": "Username" },
      { "type": "textarea", "id": "caption", "label": "Caption" },
      { "type": "url", "id": "link", "label": "Link to original post" }
    ]},
    { "type": "@app" }
  ],
  "presets": [{ "name": "Social community", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
