{%- comment -%}
  Customer reviews. Only add genuine reviews from real customers.
  The section is hidden on the storefront when it has no reviews.
{%- endcomment -%}
{%- assign reviews = section.blocks | where: 'type', 'review' -%}
{%- assign has_text = false -%}
{%- for r in reviews -%}{%- if r.settings.quote != blank -%}{%- assign has_text = true -%}{%- endif -%}{%- endfor -%}
{%- if has_text or request.design_mode -%}
<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-slider-section>
  <div class="page-width">
    <div class="section-header section-header--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <div class="testimonial-carousel" data-fade-carousel>
        {%- for block in reviews -%}
          {%- if block.settings.quote == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          <div class="testimonial{% unless forloop.first %} is-hidden{% endunless %}" data-fade-slide {{ block.shopify_attributes }}>
            {% render 'review-content', block: block %}
          </div>
        {%- endfor -%}
        {%- if reviews.size > 1 -%}
          <div class="slider-controls" style="justify-content:center;margin-top:32px">
            <button type="button" class="slider-button" data-fade-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
            <button type="button" class="slider-button" data-fade-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <ul class="grid testimonials-grid" role="list" style="--cols: 3; --cols-tablet: 2; --cols-mobile: 1;">
        {%- for block in reviews -%}
          {%- if block.settings.quote == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          <li class="testimonial" {{ block.shopify_attributes }}>{% render 'review-content', block: block %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
<style>.testimonial.is-hidden { display: none; }</style>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "div",
  "class": "section-testimonials",
  "max_blocks": 20,
  "settings": [
    { "type": "paragraph", "content": "Only publish genuine reviews from real customers. The section is hidden from shoppers until at least one review has text." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [
      { "value": "carousel", "label": "Carousel (one at a time)" }, { "value": "grid", "label": "Grid" }
    ]},
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5, "info": "0 hides the stars." },
        { "type": "product", "id": "product", "label": "Product purchased" },
        { "type": "image_picker", "id": "avatar", "label": "Customer photo (optional, with permission)" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }] }]
}
{% endschema %}
