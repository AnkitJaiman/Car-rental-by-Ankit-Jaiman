{%- if section.blocks.size > 0 -%}
<div class="trust-strip{% if section.settings.mobile_marquee %} trust-strip--marquee{% endif %}" style="--ts-bg: {{ section.settings.color_bg }}; --ts-text: {{ section.settings.color_text }};">
  <div class="page-width" style="padding:0;overflow:hidden">
    <ul class="trust-strip__list" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
      {%- if section.settings.mobile_marquee -%}
        {%- for block in section.blocks -%}
          <li class="trust-strip__item trust-strip__item--clone" aria-hidden="true">
            {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}<span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>
{%- if section.settings.mobile_marquee -%}
  <style>@media (min-width: 750px) { #shopify-section-{{ section.id }} .trust-strip__item--clone { display: none; } }</style>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Trust strip",
  "class": "section-trust-strip",
  "max_blocks": 8,
  "settings": [
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1C1B1A" },
    { "type": "checkbox", "id": "mobile_marquee", "label": "Scroll automatically on mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "925 Sterling Silver" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
          { "value": "none", "label": "None" },
          { "value": "silver", "label": "Gem" },
          { "value": "shield", "label": "Shield" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "truck", "label": "Truck" },
          { "value": "return", "label": "Return" },
          { "value": "gift", "label": "Gift" },
          { "value": "lock", "label": "Lock" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "heart", "label": "Heart" }
        ]},
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "Trust strip",
    "blocks": [
      { "type": "item", "settings": { "text": "925 Sterling Silver" } },
      { "type": "item", "settings": { "text": "Nickel & Lead Free" } },
      { "type": "item", "settings": { "text": "Free US Shipping Over $35" } },
      { "type": "item", "settings": { "text": "Free 30-Day Returns" } }
    ]
  }]
}
{% endschema %}
