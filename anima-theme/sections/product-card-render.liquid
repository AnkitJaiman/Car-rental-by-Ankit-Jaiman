{%- comment -%}
  Utility section: renders one product card in the context of /products/<handle>?section_id=product-card-render.
  Used by "Recently viewed". Not meant to be added in the Theme Editor.
{%- endcomment -%}
{%- if product -%}
  <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 20vw, 50vw', show_quick_add: false %}</li>
{%- endif -%}

{% schema %}
{ "name": "Product card (utility)", "settings": [] }
{% endschema %}
