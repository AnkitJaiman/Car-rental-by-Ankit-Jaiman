{%- comment -%}
  Recently viewed products. Handles are stored in the visitor's browser (localStorage) by the product page.
  Each card is rendered by Shopify (sections/product-card-render.liquid via the Section Rendering API), so prices are always live.
{%- endcomment -%}
<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-recently-viewed data-limit="{{ section.settings.limit }}" data-current="{{ product.handle }}" data-section-id="{{ section.id }}" hidden>
  <div class="page-width">
    <div class="section-header"><h2 class="section-header__title">{{ section.settings.heading | escape }}</h2></div>
    <ul class="grid" role="list" style="--cols: {{ section.settings.limit }}; --cols-tablet: 3; --cols-mobile: 2;" data-recently-viewed-list>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
