<div class="page-width not-found">
  <p class="eyebrow">404</p>
  <h1>{{ 'templates.404.title' | t }}</h1>
  <p class="text-muted">{{ 'templates.404.subtext' | t }}</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width:480px;margin:32px auto">
    <label for="NotFoundSearch" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
    <input type="search" id="NotFoundSearch" name="q" placeholder="{{ 'general.search.placeholder' | t }}">
    <button type="submit" class="icon-button" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
  </form>
  <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
</div>

{% schema %}
{ "name": "404 page", "class": "section-404", "settings": [] }
{% endschema %}
