{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign slide_count = slides.size
-%}
<section class="hero{% if section.settings.text_color == 'dark' %} hero--text-dark{% endif %}"
  style="--hero-h: {{ section.settings.height_desktop }}vh; --hero-h-mobile: {{ section.settings.height_mobile }}vh;"
  aria-roledescription="{% if slide_count > 1 %}carousel{% endif %}" aria-label="{{ section.settings.aria_label | escape }}"
  data-hero data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed | times: 1000 }}">
  <div class="hero__slides">
    {%- for block in slides -%}
      {%- liquid
        assign s = block.settings
        assign has_mobile = false
        if s.image_mobile != blank
          assign has_mobile = true
        endif
        assign hero_loading = 'lazy'
        assign hero_priority = 'auto'
        if forloop.first and section.index <= 2
          assign hero_loading = 'eager'
          assign hero_priority = 'high'
        endif
      -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}
        {% if slide_count > 1 %}role="group" aria-roledescription="slide" aria-label="{{ 'accessibility.slide' | t: index: forloop.index, count: slide_count }}"{% endif %}>
        <div class="hero__media{% if has_mobile %} hero__media--has-mobile{% endif %}">
          {%- if s.video != blank -%}
            <div class="hero__media--desktop" style="position:absolute;inset:0">
              {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'hero__video' }}
            </div>
          {%- elsif s.image != blank -%}
            {%- comment -%} One <picture>: phones download only the mobile image, desktops only the desktop image. {%- endcomment -%}
            <picture class="hero__picture" style="--pos-d: {{ s.image_position }}; --pos-m: {% if has_mobile %}{{ s.image_mobile_position }}{% else %}{{ s.image_position }}{% endif %};">
              {%- if has_mobile -%}
                <source media="(max-width: 749px)" sizes="100vw" srcset="
                  {%- for w in (1..5) -%}{%- assign mw = 375 | times: w | at_most: 1500 -%}{{ s.image_mobile | image_url: width: mw }} {{ mw }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}">
              {%- endif -%}
              {{ s.image | image_url: width: 2800 | image_tag: widths: '750, 1100, 1500, 1900, 2400, 2800', sizes: '100vw', loading: hero_loading, fetchpriority: hero_priority }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if has_mobile and s.video != blank -%}
            <div class="hero__media--mobile" style="position:absolute;inset:0">
              {%- capture mob_style -%}object-position: {{ s.image_mobile_position }};{%- endcapture -%}
              {{ s.image_mobile | image_url: width: 1200 | image_tag: widths: '375, 550, 750, 1000, 1200', sizes: '100vw', style: mob_style }}
            </div>
          {%- endif -%}
        </div>
        <div class="hero__overlay" style="--overlay: {{ s.overlay | divided_by: 100.0 }}; --overlay-color: {{ s.overlay_color }};"></div>
        {%- if s.video != blank -%}
          <button type="button" class="icon-button hero__video-toggle" data-hero-video-toggle data-state="playing" aria-label="{{ 'accessibility.pause_video' | t }}">{% render 'icon', name: 'pause' %}{% render 'icon', name: 'play' %}</button>
        {%- endif -%}
        <div class="hero__content page-width hero__content--{{ s.vertical }} hero__content--{{ s.alignment }}" style="--hero-text-w: {{ s.text_width }}px">
          <div class="hero__box">
            {%- if s.eyebrow != blank -%}<p class="eyebrow" style="color:inherit;opacity:.9">{{ s.eyebrow | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}
              {%- if forloop.first and section.index == 1 -%}
                <h1 class="hero__heading {{ s.heading_size }}">{{ s.heading | escape }}</h1>
              {%- else -%}
                <h2 class="hero__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if s.text != blank -%}<div class="hero__text">{{ s.text }}</div>{%- endif -%}
            {%- if s.button_label != blank or s.button_label_2 != blank -%}
              <div class="hero__buttons">
                {%- if s.button_label != blank -%}
                  <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="button{% unless section.settings.text_color == 'dark' %} button--light{% endunless %}">{{ s.button_label | escape }}</a>
                {%- endif -%}
                {%- if s.button_label_2 != blank -%}
                  <a href="{{ s.button_link_2 | default: routes.root_url }}" class="button {% if section.settings.text_color == 'dark' %}button--secondary{% else %}button--outline-light{% endif %}">{{ s.button_label_2 | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if slide_count > 1 -%}
    <div class="hero__dots" role="group" aria-label="{{ section.settings.aria_label | escape }}">
      {%- for block in slides -%}
        <button type="button" class="hero__dot" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide' | t: index: forloop.index, count: slide_count }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
    {%- if section.settings.autoplay -%}
      <button type="button" class="icon-button hero__pause" data-hero-pause aria-pressed="false" aria-label="{{ 'accessibility.pause_slideshow' | t }}">{% render 'icon', name: 'pause' %}{% render 'icon', name: 'play' %}</button>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    { "type": "range", "id": "height_desktop", "label": "Height (desktop)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 85 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "select", "id": "text_color", "label": "Text color", "default": "light", "options": [
      { "value": "light", "label": "Light (for dark images)" },
      { "value": "dark", "label": "Dark (for light images)" }
    ]},
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "info": "Only applies with 2 or more slides.", "default": true },
    { "type": "range", "id": "speed", "label": "Change slides every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Featured" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "2800 × 1600 px recommended." },
        { "type": "select", "id": "image_position", "label": "Image focus (desktop)", "default": "center center", "options": [
          { "value": "left top", "label": "Top left" }, { "value": "center top", "label": "Top" }, { "value": "right top", "label": "Top right" },
          { "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" },
          { "value": "left bottom", "label": "Bottom left" }, { "value": "center bottom", "label": "Bottom" }, { "value": "right bottom", "label": "Bottom right" }
        ]},
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, optional)", "info": "1200 × 1600 px recommended." },
        { "type": "select", "id": "image_mobile_position", "label": "Image focus (mobile)", "default": "center center", "options": [
          { "value": "center top", "label": "Top" }, { "value": "center center", "label": "Center" }, { "value": "center bottom", "label": "Bottom" },
          { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }
        ]},
        { "type": "video", "id": "video", "label": "Video (optional)", "info": "Replaces the desktop image. Plays muted and looped." },
        { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
        { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
        { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Jewelry with soul" },
        { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h0", "options": [
          { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }
        ]},
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Primary button link" },
        { "type": "text", "id": "button_label_2", "label": "Secondary button label" },
        { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
        { "type": "select", "id": "vertical", "label": "Content position", "default": "bottom", "options": [
          { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }
        ]},
        { "type": "select", "id": "alignment", "label": "Content alignment", "default": "left", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
        ]},
        { "type": "range", "id": "text_width", "label": "Text width", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 640 }
      ]
    }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
