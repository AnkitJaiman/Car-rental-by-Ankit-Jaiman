<article class="section" style="--pt: 0px; --pb: 96px;">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <p class="eyebrow"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></p>
      <h1>{{ article.title | escape }}</h1>
      <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</p>
    </header>
  </div>
  {%- if article.image -%}
    <div class="page-width article__image">
      <div class="media media--wide">{% render 'image', image: article.image, sizes: '100vw', lazy: false %}</div>
    </div>
  {%- endif -%}
  <div class="page-width page-width--narrow">
    <div class="rte main-page__content">{{ article.content }}</div>
    <p style="margin-top:48px"><a href="{{ blog.url }}" class="text-link link-underline">{{ 'templates.blog.back' | t: title: blog.title }}</a></p>
  </div>
</article>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    {%- if article.image -%}"image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
</script>

{% schema %}
{ "name": "Blog post", "class": "section-main-article", "settings": [] }
{% endschema %}
