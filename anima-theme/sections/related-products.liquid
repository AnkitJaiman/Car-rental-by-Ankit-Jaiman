{%- comment -%}
  Shopify product recommendations (loaded asynchronously so the product page stays fast).
{%- endcomment -%}
<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header section-header--{{ section.settings.header_alignment }}">
        <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-tablet: 3; --cols-mobile: 2;">
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', product: rec, sizes: '(min-width: 990px) 23vw, 50vw' %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    { "type": "paragraph", "content": "Recommendations are generated automatically by Shopify. Manage them with the Search & Discovery app." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "header_alignment", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [{ "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary (pairs well with)" }] },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
