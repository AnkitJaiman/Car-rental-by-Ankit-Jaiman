{%- liquid
  assign c = section.settings.collection
  assign img = section.settings.image | default: c.featured_image
  assign heading = section.settings.heading | default: c.title
  assign full = false
  if section.settings.layout == 'full'
    assign full = true
  endif
-%}
<section class="{% unless full %}section{% endunless %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; background: {{ section.settings.color_bg }}; color: {{ section.settings.color_text }};">
  <div class="{% unless full %}page-width{% endunless %}">
    <div class="spotlight{% if section.settings.layout == 'image_right' %} spotlight--reverse{% endif %}{% if full %} spotlight--full{% endif %}">
      <div class="spotlight__media">
        <div class="media media--{{ section.settings.image_ratio }}">
          {%- if img != blank -%}
            {%- capture pos -%}object-position: {{ section.settings.image_position }}{%- endcapture -%}
            {{ img | image_url: width: 2200 | image_tag: widths: '540, 720, 1000, 1400, 1800, 2200', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', style: pos }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if full -%}<div class="hero__overlay" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"></div>{%- endif -%}
      </div>
      <div class="spotlight__content{% if full %} page-width{% endif %} reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:inherit;opacity:.75">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if heading != blank -%}<h2 class="h1">{{ heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte" style="font-size:1.6rem;opacity:.85">{{ section.settings.text }}</div>
        {%- elsif c.description != blank and section.settings.use_collection_description -%}
          <div class="rte" style="font-size:1.6rem;opacity:.85">{{ c.description | strip_html | truncatewords: 40 }}</div>
        {%- endif -%}
        {%- if section.settings.show_products and c != blank and c.products_count > 0 and full == false -%}
          <ul class="spotlight__products" role="list" style="list-style:none;padding:0">
            {%- for product in c.products limit: 2 -%}
              <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 18vw, 45vw', show_quick_add: false %}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:3.2rem"><a href="{{ section.settings.button_link | default: c.url | default: routes.all_products_collection_url }}" class="button{% if full %} button--light{% endif %}">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial spotlight",
  "tag": "div",
  "class": "section-spotlight",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
    { "type": "select", "id": "image_position", "label": "Image focus", "default": "center center", "options": [
      { "value": "center top", "label": "Top" }, { "value": "center center", "label": "Center" }, { "value": "center bottom", "label": "Bottom" }
    ]},
    { "type": "select", "id": "image_ratio", "label": "Image ratio (split layouts)", "default": "portrait", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "tall", "label": "Tall (2:3)" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Spotlight" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title." },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "checkbox", "id": "use_collection_description", "label": "Use collection description when empty", "default": true },
    { "type": "checkbox", "id": "show_products", "label": "Show two products (split layouts)", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the collection." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_left", "options": [
      { "value": "image_left", "label": "Image left" }, { "value": "image_right", "label": "Image right" }, { "value": "full", "label": "Full-width image with text" }
    ]},
    { "type": "range", "id": "overlay", "label": "Overlay opacity (full width)", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#F7F4F0" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1C1B1A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Editorial spotlight" }]
}
{% endschema %}
