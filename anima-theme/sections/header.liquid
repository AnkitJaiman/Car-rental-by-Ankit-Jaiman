{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and request.page_type == 'index'
    assign transparent = true
  endif
  assign sticky = section.settings.sticky
-%}
<div class="header-wrapper{% if sticky %} header-wrapper--sticky{% endif %}{% if transparent %} header-wrapper--transparent{% endif %}"
  data-header data-transparent="{{ transparent }}"
  style="--logo-w: {{ section.settings.logo_width }}px; --logo-w-mobile: {{ section.settings.logo_width_mobile }}px; --header-transparent-text: {{ section.settings.transparent_text }};">
  <header class="page-width header header--logo-{{ section.settings.logo_position }}">
    <div class="header__left">
      <button type="button" class="icon-button header__menu-toggle" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
      {%- if section.settings.show_search -%}
        <button type="button" class="icon-button hide-desktop-search" data-search-open aria-label="{{ 'accessibility.open_search' | t }}">{% render 'icon', name: 'search' %}</button>
      {%- endif -%}
    </div>

    <div class="header__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {%- capture logo_sizes -%}(min-width: 990px) {{ section.settings.logo_width }}px, {{ section.settings.logo_width_mobile }}px{%- endcapture -%}
          {%- if transparent and section.settings.logo_light != blank -%}
            {{ section.settings.logo_light | image_url: width: 600 | image_tag: class: 'header__logo-img--light', alt: shop.name, widths: '200, 300, 400, 600', sizes: logo_sizes, loading: 'eager' }}
          {%- endif -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'header__logo-img--default', alt: shop.name, widths: '200, 300, 400, 600', sizes: logo_sizes, loading: 'eager' }}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="header__nav" aria-label="{{ 'accessibility.menu' | t }}">
      <ul class="nav-list" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign mega = nil
            for block in section.blocks
              assign mtitle = block.settings.menu_item | strip | downcase
              assign ltitle = link.title | strip | downcase
              if mtitle == ltitle
                assign mega = block
              endif
            endfor
          -%}
          <li class="nav-item" data-nav-item>
            {%- if link.links.size > 0 or mega -%}
              <button type="button" class="nav-link" aria-expanded="false" data-nav-toggle>
                {{ link.title | escape }} {% render 'icon', name: 'chevron-down' %}
              </button>
              {%- if mega -%}
                <div class="mega-menu" {{ mega.shopify_attributes }}>
                  {%- liquid
                    assign promo_count = 0
                    if mega.settings.image_1 != blank
                      assign promo_count = promo_count | plus: 1
                    endif
                    if mega.settings.image_2 != blank
                      assign promo_count = promo_count | plus: 1
                    endif
                    assign link_cols = link.links.size
                    assign has_grandchildren = false
                    for child in link.links
                      if child.links.size > 0
                        assign has_grandchildren = true
                      endif
                    endfor
                    if has_grandchildren == false
                      assign link_cols = 1
                    endif
                  -%}
                  <div class="page-width mega-menu__inner{% if promo_count > 0 %} mega-menu__inner--with-promo{% endif %}" style="--link-cols: {{ link_cols }}">
                    {%- if has_grandchildren -%}
                      {%- for child in link.links -%}
                        <div>
                          <a href="{{ child.url }}" class="mega-menu__title">{{ child.title | escape }}</a>
                          <ul class="mega-menu__list" role="list">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endfor -%}
                      {%- unless link.url == '#' or link.url == blank -%}
                        <div><a href="{{ link.url }}" class="mega-menu__title link-underline">{{ 'general.view_all' | t }} {{ link.title | escape }}</a></div>
                      {%- endunless -%}
                    {%- else -%}
                      <div>
                        <a href="{{ link.url }}" class="mega-menu__title">{{ mega.settings.heading | default: link.title | escape }}</a>
                        <ul class="mega-menu__list" role="list">
                          {%- for child in link.links -%}
                            <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                          {%- endfor -%}
                          <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                        </ul>
                      </div>
                    {%- endif -%}
                    {%- if promo_count > 0 -%}
                      <div class="mega-menu__promos">
                        {%- for i in (1..2) -%}
                          {%- liquid
                            assign img_key = 'image_' | append: i
                            assign txt_key = 'text_' | append: i
                            assign url_key = 'link_' | append: i
                            assign promo_img = mega.settings[img_key]
                          -%}
                          {%- if promo_img != blank -%}
                            <a href="{{ mega.settings[url_key] | default: link.url }}" class="mega-menu__promo">
                              <div class="media media--portrait">{% render 'image', image: promo_img, sizes: '20vw', widths: '300, 450, 600' %}</div>
                              <p>{{ mega.settings[txt_key] | escape }}</p>
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- else -%}
                <ul class="dropdown" role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                  {%- unless link.url == '#' or link.url == blank -%}
                    <li class="dropdown__all"><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                  {%- endunless -%}
                </ul>
              {%- endif -%}
            {%- else -%}
              <a href="{{ link.url }}" class="nav-link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      {%- if section.settings.show_search -%}
        <button type="button" class="icon-button show-desktop-search" data-search-open aria-label="{{ 'accessibility.open_search' | t }}">{% render 'icon', name: 'search' %}</button>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="icon-button header__account" aria-label="{{ 'accessibility.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button" data-cart-open aria-label="{{ 'accessibility.cart' | t }}, {{ 'accessibility.cart_count' | t: count: cart.item_count }}" id="CartIcon">
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}><span>{{ cart.item_count }}</span></span>
      </a>
    </div>
  </header>
</div>

<style>
  @media (max-width: 989px) { .show-desktop-search, .header__account { display: none !important; } }
  @media (min-width: 990px) { .hide-desktop-search { display: none !important; } }
</style>

{%- comment -%} Mobile menu drawer {%- endcomment -%}
<div class="drawer drawer--left" id="MenuDrawer" aria-hidden="true">
  <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'accessibility.close_menu' | t }}"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}" tabindex="-1">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'accessibility.menu' | t }}</span>
      <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'accessibility.close_menu' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      <ul class="mobile-nav" role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary>{{ link.title | escape }} {% render 'icon', name: 'chevron-down' %}</summary>
                <ul role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                    {%- for grandchild in child.links -%}
                      <li><a href="{{ grandchild.url }}" class="mobile-nav__grandchild">{{ grandchild.title | escape }}</a></li>
                    {%- endfor -%}
                  {%- endfor -%}
                  <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="mobile-nav__secondary">
        {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
          <a href="{{ routes.account_url }}" style="display:flex;gap:10px;align-items:center">{% render 'icon', name: 'account' %} {{ 'accessibility.account' | t }}</a>
        {%- endif -%}
        {%- if settings.support_email != blank -%}
          <a href="mailto:{{ settings.support_email }}" style="display:flex;gap:10px;align-items:center">{% render 'icon', name: 'mail' %} {{ settings.support_email | escape }}</a>
        {%- endif -%}
        {%- render 'social-icons' -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_search -%}
  <div class="search-modal" id="SearchModal" data-search-modal aria-hidden="true">
    <button type="button" class="drawer__overlay" data-search-close tabindex="-1" aria-label="{{ 'accessibility.close_search' | t }}" style="position:fixed"></button>
    <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}">
      <div class="page-width">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          {% render 'icon', name: 'search' %}
          <label for="SearchInput" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
          <input type="search" id="SearchInput" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search"
            {% if settings.predictive_search %}data-predictive-search role="combobox" aria-expanded="false" aria-controls="PredictiveResults" aria-autocomplete="list"{% endif %}>
          <input type="hidden" name="options[prefix]" value="last">
          <button type="button" class="icon-button" data-search-close aria-label="{{ 'accessibility.close_search' | t }}">{% render 'icon', name: 'close' %}</button>
        </form>
        {%- liquid
          assign popular = section.settings.search_popular | split: ','
          assign browse_menu = section.settings.search_menu
        -%}
        {%- if popular.size > 0 or browse_menu.links.size > 0 -%}
          <div class="predictive predictive--start" data-search-start>
            {%- if popular.size > 0 -%}
              <div class="predictive__group">
                <p class="predictive__label">{{ 'general.search.popular' | t }}</p>
                <ul class="predictive__chips" role="list">
                  {%- for term in popular -%}
                    {%- assign t = term | strip -%}
                    {%- if t != blank -%}<li><a href="{{ routes.search_url }}?q={{ t | url_encode }}&options%5Bprefix%5D=last" class="predictive__chip">{{ t | escape }}</a></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            {%- if browse_menu.links.size > 0 -%}
              <div class="predictive__group">
                <p class="predictive__label">{{ 'general.search.browse' | t }}</p>
                <ul class="predictive__chips" role="list">
                  {%- for link in browse_menu.links limit: 8 -%}
                    {%- unless link.type == 'collection_link' or link.type == 'catalog_link' or link.type == 'collections_link' -%}{%- continue -%}{%- endunless -%}
                    {%- if link.type == 'collection_link' and link.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
                    {%- unless link.url == '#' -%}<li><a href="{{ link.url }}" class="predictive__chip predictive__chip--collection">{{ link.title | escape }}</a></li>{%- endunless -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div id="PredictiveResults" class="predictive-results" data-predictive-results aria-live="polite"></div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-site-header",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "logo_light", "label": "Light logo", "info": "Shown on the transparent header over images." },
    { "type": "range", "id": "logo_width", "label": "Logo width (desktop)", "min": 60, "max": 300, "step": 5, "unit": "px", "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 50, "max": 200, "step": 5, "unit": "px", "default": 110 },
    { "type": "select", "id": "logo_position", "label": "Desktop logo position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ]},
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Add a nested menu item to create a dropdown. Add a “Mega menu” block to turn a top-level item into a mega menu." },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_popular", "label": "Popular searches", "info": "Comma-separated. Shown when the search opens, before typing.", "default": "Montana sapphire, Moissanite ring, Emerald, Tennis bracelet" },
    { "type": "link_list", "id": "search_menu", "label": "Search: category links", "info": "Shown when the search opens. Empty collections are skipped." },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "transparent_home", "label": "Transparent header on home page", "info": "Sits over the first section. Use with a full-width hero.", "default": false },
    { "type": "color", "id": "transparent_text", "label": "Transparent header text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item", "info": "Enter the exact title of a top-level menu item, e.g. “Rings”." },
        { "type": "text", "id": "heading", "label": "Column heading (optional)" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "text_1", "label": "Image 1 text" },
        { "type": "url", "id": "link_1", "label": "Image 1 link" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "text_2", "label": "Image 2 text" },
        { "type": "url", "id": "link_2", "label": "Image 2 link" }
      ]
    }
  ]
}
{% endschema %}
