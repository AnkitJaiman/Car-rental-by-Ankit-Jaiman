{%- liquid
  assign col_tag = 'h2'
  if section.settings.heading != blank
    assign col_tag = 'h3'
  endif
  assign section_lazy = true
  if section.index <= 2
    assign section_lazy = false
  endif
-%}
<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="section-header__title">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    {%- endif -%}
    <ul class="icon-list{% if section.settings.alignment == 'center' %} icon-list--center{% endif %}" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        <li class="icon-list__item reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media media--{{ section.settings.image_ratio }}" style="margin-bottom:20px">{% render 'image', image: block.settings.image, lazy: section_lazy, sizes: '(min-width: 990px) 30vw, 100vw', widths: '360, 540, 720, 900' %}</div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="icon-list__icon" style="display:block">{% render 'icon', name: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<{{ col_tag }}>{{ block.settings.title | escape }}</{{ col_tag }}>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<p style="margin-top:12px"><a href="{{ block.settings.link }}" class="text-link link-underline">{{ block.settings.link_label | escape }}</a></p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "div",
  "class": "section-multicolumn",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Anima promise" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }] },
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "column", "name": "Column", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
        { "value": "none", "label": "None" }, { "value": "silver", "label": "Gem" }, { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" },
        { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "gift", "label": "Gift" }, { "value": "lock", "label": "Lock" },
        { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "ring", "label": "Ring" }, { "value": "mail", "label": "Mail" }
      ]},
      { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
      { "type": "text", "id": "title", "label": "Title", "default": "Column" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Multicolumn", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
