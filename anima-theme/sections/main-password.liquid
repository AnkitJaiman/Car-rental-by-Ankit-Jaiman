<div class="section password-page" style="--pt: 96px; --pb: 96px;">
  <div class="page-width text-center" style="max-width:560px">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, widths: '200, 300, 400', sizes: '200px', style: 'width:180px;height:auto;margin:0 auto 32px' }}
    {%- else -%}
      <p class="header__logo-text" style="margin-bottom:32px">{{ shop.name | escape }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: 'password.title' | t | escape }}</h1>
    {%- if shop.password_message != blank -%}<div class="rte text-muted">{{ shop.password_message }}</div>{%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div style="margin-top:32px">{% render 'newsletter-form', form_id: 'PasswordNewsletter' %}</div>
    {%- endif -%}

    <details style="margin-top:48px">
      <summary class="text-link link-underline" style="cursor:pointer">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field" style="margin-top:20px;text-align:left"><span class="field__label">{{ 'password.password' | t }}</span>
          <input class="field__input" type="password" name="password" autocomplete="current-password" required></label>
        <button type="submit" class="button button--full">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true }
  ]
}
{% endschema %}
