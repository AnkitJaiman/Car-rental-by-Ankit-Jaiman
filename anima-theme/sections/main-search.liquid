<div class="section" style="--pt: 48px; --pb: 80px;" data-collection-section data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="page-header" style="padding-top:0">
      <h1 class="page-header__title h2">
        {%- if search.performed and search.terms != blank -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search.title' | t }}{%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width:560px;margin:24px auto 0">
        <label for="MainSearch" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
        <input type="search" id="MainSearch" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="icon-button" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- render 'collection-toolbar', results: search, section: section -%}
        <div data-collection-results>
          {% render 'active-facets', results: search %}
          {%- if search.results_count == 0 -%}
            <div class="collection-empty"><p>{{ 'general.search.no_results' | t: terms: search.terms }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
          {%- else -%}
            <ul class="grid collection-grid" role="list" data-product-grid style="--cols: 4; --cols-tablet: 3; --cols-mobile: 2;">
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card', product: item %}
                    {%- when 'article' -%}
                      <a href="{{ item.url }}" class="product-card">
                        <div class="media media--portrait">{%- if item.image -%}{% render 'image', image: item.image, sizes: '(min-width: 990px) 25vw, 50vw' %}{%- endif -%}</div>
                        <div class="product-card__info"><span class="product-card__vendor">{{ item.blog.title | escape }}</span><h3 class="product-card__title">{{ item.title | escape }}</h3></div>
                      </a>
                    {%- when 'page' -%}
                      <a href="{{ item.url }}" class="product-card" style="border:1px solid var(--color-line);padding:24px;height:100%">
                        <span class="product-card__vendor">{{ 'general.search.pages' | t }}</span>
                        <h3 class="product-card__title" style="margin-top:8px">{{ item.title | escape }}</h3>
                      </a>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate, style: 'numbers' %}
          {%- endif -%}
        </div>
      {%- endpaginate -%}
      {%- if section.settings.enable_filtering -%}{% render 'facets-drawer', results: search, section: section %}{%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "settings": [
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ]
}
{% endschema %}
