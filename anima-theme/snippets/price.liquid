{%- comment -%}
  Live Shopify price. Params: product (required), variant (optional), show_from (boolean), class
{%- endcomment -%}
{%- liquid
  if variant
    assign target = variant
  else
    assign target = product.selected_or_first_available_variant
  endif
  assign price = target.price
  assign compare_at = target.compare_at_price
  if variant == blank and product.price_varies and show_from
    assign price = product.price_min
    assign compare_at = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %} {{ class }}" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'accessibility.sale_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if variant == blank and product.price_varies and show_from -%}
      {{ 'products.product.from_price' | t: price: price | money }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'accessibility.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_at | money }}</s>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }} / {% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif %}{{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
