<div data-cart-totals>
{%- if cart.cart_level_discount_applications.size > 0 -%}
  {%- for discount in cart.cart_level_discount_applications -%}
    <div class="cart-summary__row text-muted"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
  {%- endfor -%}
{%- endif -%}
<div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-total>{{ cart.total_price | money_with_currency }}</strong></div>
</div>
{%- if settings.cart_note_text != blank -%}
  <div class="cart-summary__note">{{ settings.cart_note_text }}</div>
{%- endif -%}
<button type="submit" name="checkout" form="CartForm{{ form_suffix }}" class="button button--full"{% if cart.item_count == 0 %} disabled{% endif %}>
  {%- render 'icon', name: 'lock' -%} {{ 'cart.checkout' | t }}
</button>
{%- if additional_checkout_buttons and show_dynamic -%}
  <div class="cart-summary__dynamic" style="margin-top:10px">{{ content_for_additional_checkout_buttons }}</div>
{%- endif -%}
<p class="cart-reassurance">{% render 'icon', name: 'lock' %} {{ 'cart.secure_checkout' | t }}</p>
