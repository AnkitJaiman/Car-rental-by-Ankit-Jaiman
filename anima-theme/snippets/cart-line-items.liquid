{%- comment -%} Shared cart line items for drawer and cart page. Param: sizes {%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="media media--portrait" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '120, 200, 300', sizes: '120px' }}
        {%- endif -%}
      </a>
      <div>
        <h3 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__options">
            {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__options">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        <div class="cart-item__actions">
          <div class="quantity">
            <button type="button" data-qty-change="-1" aria-label="{{ 'accessibility.decrease_quantity' | t: product: item.product.title | escape }}">−</button>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line-qty aria-label="{{ 'products.product.quantity' | t }}"{% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %} max="{{ item.variant.inventory_quantity }}"{% endif %}>
            <button type="button" data-qty-change="1" aria-label="{{ 'accessibility.increase_quantity' | t: product: item.product.title | escape }}">+</button>
          </div>
          <button type="button" class="cart-item__remove" data-line-remove aria-label="{{ 'accessibility.remove' | t: product: item.product.title | escape }}">{{ 'cart.remove' | t }}</button>
        </div>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s><br>
        {%- endif -%}
        {{ item.final_line_price | money }}
        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="cart-item__discounts">
            {%- for discount in item.line_level_discount_allocations -%}
              <li>{{ discount.discount_application.title }} (−{{ discount.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
