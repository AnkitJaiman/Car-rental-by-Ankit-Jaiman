{%- comment -%}
  Responsive image with srcset, explicit dimensions (no layout shift) and lazy loading.
  Params:
  - image (required): image object
  - sizes: sizes attribute (default 100vw)
  - lazy: boolean (default true). Pass false for above-the-fold images.
  - priority: boolean. Adds fetchpriority=high (use only for the single LCP image).
  - decorative: boolean. Empty alt text.
  - class, alt, widths (comma string)
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign img_sizes = sizes | default: '100vw'
    assign img_widths = widths | default: '360, 540, 720, 900, 1100, 1400, 1800, 2200'
    assign img_alt = alt | default: image.alt | default: ''
    if decorative
      assign img_alt = ''
    endif
    assign fetch_priority = 'auto'
    if lazy == false
      assign loading = 'eager'
      if priority
        assign fetch_priority = 'high'
      endif
    else
      assign loading = 'lazy'
    endif
  -%}
  {{ image | image_url: width: 2400 | image_tag:
    widths: img_widths,
    sizes: img_sizes,
    loading: loading,
    fetchpriority: fetch_priority,
    alt: img_alt,
    class: class
  }}
{%- endif -%}
